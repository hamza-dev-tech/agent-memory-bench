# answering + judging model (free tier is enough)
GROQ_API_KEY=

# GoodMem, if you are running it. Your own instance and your own spaces: the
# ones this benchmark ran against belong to the vendor and are not published.
GOODMEM_API_KEY=
GOODMEM_BASE_URL=
GOODMEM_DEFAULT_SPACE=
GOODMEM_OPTIMIZED_SPACE=
GOODMEM_LLM_ID=
GOODMEM_RERANKER_ID=

# self-hosted systems
LETTA_BASE_URL=http://localhost:8283
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# workload overrides
MEMBENCH_CONVERSATIONS=2
MEMBENCH_PROBES=60
MEMBENCH_TOP_K=10
